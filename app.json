{
  "expo": {
    "name": "Stage Cover",
    "slug": "stage-cover",
    "version": "1.4.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "stagecover",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mattruiz.stagecover",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Stage Cover uses the camera to record the play.",
        "NSMicrophoneUsageDescription": "Stage Cover records the play's sound with the video.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "stagecover",
              "com.googleusercontent.apps.163858800670-aejpqnbh5a6f4snsp611vd14v7n7o7ul"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.mattruiz.stagecover",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Stage Cover uses a picture from your library as the screen while it records.",
          "cameraPermission": "Stage Cover uses the camera to record the play.",
          "microphonePermission": "Stage Cover records the play's sound with the video."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Stage Cover uses a picture from your library as the screen while it records.",
          "savePhotosPermission": "Stage Cover saves the recording to Photos.",
          "granularPermissions": ["video"]
        }
      ],
      "expo-brightness",
      "expo-battery",
      [
        "expo-screen-orientation",
        {
          "startOrientation": "DEFAULT"
        }
      ]
    ]
  }
}
