{
  "expo": {
    "name": "BlacRec",
    "slug": "blacrec",
    "version": "1.5.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "blacrec",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mattruiz.stagecover",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "BlacRec uses the camera to record the play.",
        "NSMicrophoneUsageDescription": "BlacRec records the play's sound with the video.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "processing"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "blacrec",
              "com.googleusercontent.apps.266949663759-svhu4seqs0k4kagkjnfdd93i0i501ddg"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.mattruiz.stagecover",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "BlacRec uses a picture from your library as the screen while it records.",
          "cameraPermission": "BlacRec uses the camera to record the play.",
          "microphonePermission": "BlacRec records the play's sound with the video."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "BlacRec uses a picture from your library as the screen while it records.",
          "savePhotosPermission": "BlacRec saves the recording to Photos.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      [
        "expo-screen-orientation",
        {
          "startOrientation": "DEFAULT"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-audio"
    ]
  }
}
